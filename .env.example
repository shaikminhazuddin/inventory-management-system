# ==============================================================================
# INVENTORY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or set these variables in Render.
# IMPORTANT: Never commit actual passwords or .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: Local MySQL Server (Default)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/inventory_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=your_local_mysql_password

# ------------------------------------------------------------------------------
# OPTION B: TiDB Cloud Starter / Serverless (Production on Render)
# ------------------------------------------------------------------------------
# In TiDB Cloud, obtain these values from your cluster's "Connect" modal:
# - Host: e.g. gateway01.us-east-1.prod.aws.tidbcloud.com
# - Port: 4000
# - Database: inventory_management
# - sslMode=VERIFY_IDENTITY enforces TLS certificate verification via JVM truststore.
#
# DB_URL=jdbc:mysql://<host>:4000/inventory_management?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
# DB_USER=<prefix>.root
# DB_PASSWORD=your_tidb_cloud_password

# ------------------------------------------------------------------------------
# Optional Application Settings
# ------------------------------------------------------------------------------
# PORT=8080
# ENVIRONMENT=production
